#!/usr/bin/env bash
# asdf-pipelinek bin/download: fetch canonical ZIP + SHA256SUMS, verify fail-closed.
# Never compiles PipelineK; never installs Java.
set -euo pipefail

VERSION="${ASDF_INSTALL_VERSION}"
GH_REPO="Rubentxu/pipeline-kotlin"
BASE_URL="https://github.com/${GH_REPO}/releases/download/v${VERSION}"

download_dir="${ASDF_DOWNLOAD_PATH:-$(mktemp -d)}"
mkdir -p "$download_dir"

zip_name="pipelinek-${VERSION}.zip"
sums_name="pipelinek-${VERSION}.SHA256SUMS"

echo "Downloading ${BASE_URL}/${zip_name}"
if ! curl -fsSL --retry 3 -o "${download_dir}/${zip_name}" "${BASE_URL}/${zip_name}"; then
  echo "ERROR: could not download ${zip_name}. Check your network/proxy" >&2
  echo "(HTTPS_PROXY) and that version ${VERSION} exists:" >&2
  echo "  https://github.com/${GH_REPO}/releases/tag/v${VERSION}" >&2
  exit 1
fi

echo "Downloading ${BASE_URL}/${sums_name}"
if ! curl -fsSL --retry 3 -o "${download_dir}/${sums_name}" "${BASE_URL}/${sums_name}"; then
  echo "ERROR: could not download SHA256SUMS for ${VERSION}. Fail-closed abort." >&2
  exit 1
fi

cd "$download_dir"
expected="$(grep " ${zip_name}\$" "$sums_name" | awk '{print $1}')"
if [ -z "$expected" ]; then
  echo "ERROR: ${sums_name} does not contain an entry for ${zip_name}. Fail-closed abort." >&2
  exit 1
fi
actual="$(sha256sum "$zip_name" | awk '{print $1}')"
if [ "$actual" != "$expected" ]; then
  echo "ERROR: SHA-256 verification FAILED for ${zip_name}. " >&2
  echo "The downloaded artifact does not match the published digest. Fail-closed abort;" >&2
  echo "no partial installation was left behind." >&2
  exit 1
fi
echo "SHA-256 verified OK."
