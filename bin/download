#!/usr/bin/env bash
# asdf-pipelinek bin/download: fetch the canonical ZIP + digest manifest,
# verify SHA-256, fail closed. Never compiles PipelineK; never installs Java.
set -euo pipefail

VERSION="${ASDF_INSTALL_VERSION:-}"
if [ -z "$VERSION" ]; then
  echo "ERROR: ASDF_INSTALL_VERSION is not set." >&2
  exit 1
fi

dir="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=../lib/common.bash
source "${dir}/lib/common.bash"

download_dir="${ASDF_DOWNLOAD_PATH:-$(mktemp -d)}"
mkdir -p "$download_dir"

sums_name="$(pk_sums_asset)"
sums_url="$(pk_release_url "$VERSION" "$sums_name")"
tag_url="https://github.com/${PK_GH_REPO}/releases/tag/v${VERSION}"

fetch() {
  # Release assets are public, so an absent token is not an error; pk_fetch
  # just falls back to anonymous access, which still works but is rate limited.
  pk_fetch "$1" "$2"
}

# The manifest is fetched FIRST because it is both the digest authority and the
# index of what this release contains. The artifact's name is read out of it,
# so it has to be in hand before anything can be downloaded. That ordering is
# also why the artifact URL is never reconstructed from the version: see
# pk_distribution_zip for why deriving it cannot work for a release candidate.
echo "Downloading ${sums_url}"
if ! fetch "$sums_url" "${download_dir}/${sums_name}"; then
  pk_explain_fetch_failure "$sums_name" "$VERSION"
  echo "This release is unusable without its digest manifest. Fail-closed abort." >&2
  echo "  ${tag_url}" >&2
  exit 1
fi

sums_path="${download_dir}/${sums_name}"

if ! zip_name="$(pk_distribution_zip "$sums_path")"; then
  echo "ERROR: ${sums_name} does not identify a distribution archive. Fail-closed abort." >&2
  echo "  ${tag_url}" >&2
  exit 1
fi

zip_url="$(pk_release_url "$VERSION" "$zip_name")"

echo "Downloading ${zip_url}"
if ! fetch "$zip_url" "${download_dir}/${zip_name}"; then
  # Distinguish "no such version" from "GitHub refused us", which both used to
  # surface as the same opaque "could not download" message.
  pk_explain_fetch_failure "$zip_name" "$VERSION"
  echo "  ${tag_url}" >&2
  exit 1
fi

if ! expected="$(pk_manifest_digest "$sums_path" "$zip_name")"; then
  echo "ERROR: ${zip_name} is listed ambiguously in ${sums_name}. Fail-closed abort." >&2
  exit 1
fi

actual="$(sha256sum "${download_dir}/${zip_name}" | awk '{print $1}')"
if [ "$actual" != "$expected" ]; then
  echo "ERROR: SHA-256 verification FAILED for ${zip_name}." >&2
  echo "Expected: ${expected}" >&2
  echo "Actual:   ${actual}" >&2
  echo "The downloaded artifact does not match the published digest. Fail-closed abort;" >&2
  echo "no partial installation was left behind." >&2
  exit 1
fi

echo "SHA-256 verified OK."
