#!/usr/bin/env bash
# asdf-pipelinek bin/install: extract an already-verified canonical ZIP.
# No compilation, no JDK install. Requires java on PATH at shim-exec time.
set -euo pipefail

VERSION="${ASDF_INSTALL_VERSION:-}"
download_dir="${ASDF_DOWNLOAD_PATH:-}"
install_dir="${ASDF_INSTALL_PATH:-}"

if [ -z "$download_dir" ] || [ -z "$install_dir" ]; then
  echo "ERROR: ASDF_DOWNLOAD_PATH and ASDF_INSTALL_PATH must be set by asdf." >&2
  exit 1
fi

dir="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=../lib/common.bash
source "${dir}/lib/common.bash"

zip_name=""
# Locate the archive bin/download actually verified. The name is discovered, not
# recomputed from the version: a release candidate and the GA promoted from it
# do not necessarily carry an asset named after the tag they hang from, so any
# reconstruction here would fail on exactly the versions that matter.
#
# A missing download directory is "no archives", not an error to propagate:
# find exits non-zero on it, and under set -e that would abort before the
# fail-closed message below could explain what was missing.
zips=""
if [ -d "$download_dir" ]; then
  zips="$(find "$download_dir" -maxdepth 1 -type f -name 'pipelinek-*.zip' 2>/dev/null || true)"
fi
zip_count="$(printf '%s\n' "$zips" | grep -c . || true)"

# Fail-closed: refuse to install unless bin/download already fetched the ZIP.
if [ "$zip_count" -eq 0 ]; then
  echo "ERROR: no pipelinek-*.zip found in ${download_dir}. Run bin/download first." >&2
  exit 1
fi
if [ "$zip_count" -gt 1 ]; then
  # Two archives in one download directory means the resolution cannot be
  # trusted to have picked one; installing either would be a guess.
  echo "ERROR: ${download_dir} holds ${zip_count} distribution archives." >&2
  echo "Refusing to guess which one to install. Fail-closed abort." >&2
  # shellcheck disable=SC2086  # deliberate: one path per line, unquoted so each becomes an argument
  printf '  %s\n' $zips >&2
  exit 1
fi

zip_path="$zips"
zip_name="${zip_path##*/}"

# Never mutate another version: start from a clean install path.
rm -rf "$install_dir"
mkdir -p "$install_dir"

unzip -q "$zip_path" -d "$install_dir"

# The release ZIP wraps everything in a single top-level directory whose name is
# NOT guaranteed to relate to the version: the published v0.43.0 artifact
# unpacks to "pipelinek-0.43.0-rc1" while v0.40.0 ships "pipelinek-0.40.0-rc8".
# Detect that directory structurally, by finding the one that actually contains
# bin/pipelinek, instead of guessing its name from the version. This also
# handles a ZIP that is already flat, and any future upstream renaming.
topdirs="$(find "$install_dir" -mindepth 1 -maxdepth 1 -type d | sort)"
count="$(printf '%s\n' "$topdirs" | grep -c .)"

if [ -x "${install_dir}/bin/pipelinek" ]; then
  : # already flat at the install root
elif [ "$count" -eq 1 ] && [ -x "${topdirs}/bin/pipelinek" ]; then
  inner="$topdirs"
  for child in bin lib; do
    if [ -e "${inner}/${child}" ]; then
      mv "${inner}/${child}" "${install_dir}/${child}"
    fi
  done
  # Drop the now-empty wrapper, but only if nothing else lives in it.
  rmdir "$inner" 2>/dev/null || true
else
  echo "ERROR: could not locate bin/pipelinek inside ${zip_name}. Fail-closed abort." >&2
  echo "Top-level entries found: ${topdirs:-<none>}" >&2
  exit 1
fi

if [ ! -x "${install_dir}/bin/pipelinek" ]; then
  echo "ERROR: expected launcher bin/pipelinek not found after extraction. Fail-closed abort." >&2
  exit 1
fi

echo "pipelinek ${VERSION} installed."
echo
echo "NOTE: PipelineK requires JDK 21+. If 'pipelinek version' fails with a Java error:"
echo "  - asdf:  asdf plugin add java https://github.com/halcyon/asdf-java.git && asdf install java temurin-21"
echo "  - mise:  mise use -g java@temurin-21"
echo "  - or use a system JDK 21+ / SDKMAN (official channel once onboarding completes)."
