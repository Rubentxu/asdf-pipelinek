#!/usr/bin/env bash
# Requires java on PATH at shim-exec time; see README (JDK 21+).
# asdf-pipelinek bin/install: extract verified canonical ZIP. No compilation, no JDK install.
set -euo pipefail

VERSION="${ASDF_INSTALL_VERSION}"
download_dir="${ASDF_DOWNLOAD_PATH}"
install_dir="${ASDF_INSTALL_PATH}"

zip_name="pipelinek-${VERSION}.zip"

# Fail-closed: refuse to install if the download was not verified.
if [ ! -f "${download_dir}/${zip_name}" ]; then
  echo "ERROR: ${zip_name} not found in download dir. Run bin/download first." >&2
  exit 1
fi

# If a previous partial install exists, start clean (never mutate other versions).
rm -rf "$install_dir"
mkdir -p "$install_dir"

unzip -q "${download_dir}/${zip_name}" -d "$install_dir"

# Flatten: expose <install>/bin/pipelinek (asdf list-bin-paths 'bin' expects bin/ at install root).
if [ -d "${install_dir}/pipelinek-${VERSION}" ]; then
  mv "${install_dir}/pipelinek-${VERSION}/bin" "${install_dir}/bin"
  mv "${install_dir}/pipelinek-${VERSION}/lib" "${install_dir}/lib"
  rmdir "${install_dir}/pipelinek-${VERSION}"
fi

if [ ! -x "${install_dir}/bin/pipelinek" ]; then
  echo "ERROR: expected launcher bin/pipelinek not found after extraction. Fail-closed abort." >&2
  exit 1
fi

echo "pipelinek ${VERSION} installed."
echo
echo "NOTE: PipelineK requires JDK 21+. If 'pipelinek version' fails with a Java error:"
echo "  - asdf:  asdf plugin add java https://github.com/halcyon/asdf-java.git && asdf install java temurin-21"
echo "  - mise:  mise use -g java@temurin-21"
echo "  - or use a system JDK 21+ / SDKMAN (official channel once onboarding completes)."
