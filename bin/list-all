#!/usr/bin/env bash
# asdf-pipelinek bin/list-all: all installable versions.
#
# asdf 0.19 contract: ONE line, space separated, newest version last.
#
# Authentication: lib/common.bash resolves a token from GITHUB_TOKEN,
# GITHUB_API_TOKEN, the gh CLI or the gh config file. GitHub allows only 60
# anonymous requests per hour, which CI exhausts quickly. A failed
# authenticated request is retried anonymously so a bad token cannot make the
# plugin unusable.
set -euo pipefail

dir="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=../lib/common.bash
source "${dir}/lib/common.bash"

api="https://api.github.com/repos/${PK_GH_REPO}/releases?per_page=100"

fetch_tags() {
  # $1 is "auth" to force the token path, "anon" to force anonymous.
  local token="" json=""
  if [ "$1" = "auth" ] && token="$(pk_github_token)"; then
    json="$(curl -fsSL --retry 3 -H "Authorization: token ${token}" "$api" 2>/dev/null)" || return 1
  else
    json="$(curl -fsSL --retry 3 "$api" 2>/dev/null)" || return 1
  fi
  # Parse tag_name without assuming the JSON is pretty-printed, and without
  # depending on a specific number of spaces after the colon.
  printf '%s' "$json" | awk '
    match($0, /"tag_name"[[:space:]]*:[[:space:]]*"[^"]*"/) {
      s = substr($0, RSTART, RLENGTH)
      sub(/^"tag_name"[[:space:]]*:[[:space:]]*"/, "", s)
      sub(/"$/, "", s)
      sub(/^v/, "", s)
      if (s != "") print s
    }
  ' | sort -u
}

tags="$(fetch_tags auth || fetch_tags anon || true)"

if [ -z "$tags" ]; then
  echo "ERROR: could not list releases of ${PK_GH_REPO}." >&2
  echo "" >&2
  echo "Troubleshooting:" >&2
  echo "  1. Check your internet connection" >&2
  echo "  2. GitHub API rate limit may be exceeded" >&2
  echo "  3. To increase the limit, authenticate with GitHub:" >&2
  echo "     - Run: gh auth login" >&2
  echo "     - Or set GITHUB_TOKEN in your environment" >&2
  exit 1
fi

# Ascending SemVer order, so the newest version is last and a stable release
# is ordered after its own prereleases.
printf '%s\n' "$tags" | pk_sort_versions | tr '\n' ' ' | sed 's/  */ /g; s/^ //; s/ $//'
printf '\n'
